{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "English Question Lab Explanation Patch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "setId", "sourceRevision", "sourceFingerprint", "explanations"],
  "properties": {
    "schemaId": { "const": "english-question-lab-explanation-v1" },
    "setId": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "integer", "minimum": 1 },
    "sourceFingerprint": { "type": "string", "pattern": "^fnv1a32:[0-9a-f]{8}$" },
    "explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "explanation", "intention", "evidenceRefs", "distractorReasons"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "intention": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "distractorReasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
