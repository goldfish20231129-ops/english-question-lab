{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-question-lab.local/schema/provided-passage-response-v0.2.json",
  "title": "English Question Lab Provided Passage Generation Response V0.2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaId", "mode", "subject", "sourcePassageId", "sourceFingerprint", "title", "items"],
  "properties": {
    "schemaId": { "const": "english-question-lab-provided-passage-generation-v0.2" },
    "mode": { "const": "school_english_provided_passage" }, "subject": { "const": "English" },
    "sourcePassageId": { "type": "string", "minLength": 1 }, "sourceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "title": { "type": "string" }, "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "evidenceSpan": {
      "type": "object", "additionalProperties": false, "required": ["sentenceId", "start", "end", "text"],
      "properties": { "sentenceId": { "type": "string", "pattern": "^s[1-9][0-9]*$" }, "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 } }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "stem", "choices", "answerIndex", "evidenceSpans", "score"],
      "properties": {
        "type": { "enum": ["내용 일치 및 불일치", "내용 이해", "문장 삽입", "어법", "요약문 완성"] }, "stem": { "type": "string", "minLength": 1 },
        "choices": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
        "answerIndex": { "type": "integer", "minimum": 1, "maximum": 5 }, "explanation": { "type": "string", "minLength": 1 },
        "intention": { "type": "string", "minLength": 1 }, "summaryText": { "type": "string", "minLength": 1 }, "evidenceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceSpan" } },
        "distractorReasons": { "type": "array", "minItems": 4, "maxItems": 5, "items": { "type": "string", "minLength": 1 } }, "score": { "type": "number", "minimum": 1, "maximum": 10 }
      }
    },
    "insertionOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "generatedSentence", "candidateBoundaryIds", "answerBoundaryId", "positionReasons", "beforeEvidence", "afterEvidence", "lexicalLevel"],
      "properties": {
        "kind": { "const": "insert_sentence" }, "generatedSentence": { "type": "string", "minLength": 1 },
        "candidateBoundaryIds": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "answerBoundaryId": { "type": "string" }, "positionReasons": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["boundaryId", "reason"], "properties": { "boundaryId": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } } } },
        "beforeEvidence": { "$ref": "#/$defs/evidenceSpan" }, "afterEvidence": { "$ref": "#/$defs/evidenceSpan" },
        "lexicalLevel": { "enum": ["source_matched", "grade_1", "grade_2", "grade_3_csat"] }
      }
    },
    "grammarOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "grammarTarget", "grammarMode", "testedSpan", "sourceForm", "presentedForm", "ruleCheck", "sourceTextModified"],
      "properties": {
        "kind": { "const": "grammar_check" },
        "grammarTarget": { "enum": ["relative_clause", "appositive_that", "subject_verb_agreement", "participle_clause", "nonrestrictive_relative", "pronoun_agreement", "dummy_it", "cleft_it_that"] },
        "grammarMode": { "enum": ["source_form_check", "controlled_error_variant"] }, "testedSpan": { "$ref": "#/$defs/evidenceSpan" },
        "sourceForm": { "type": "string", "minLength": 1 }, "presentedForm": { "type": "string", "minLength": 1 },
        "ruleCheck": { "type": "object", "additionalProperties": false, "required": ["classification", "decisionRule", "contrastWith", "isUniquelyDetermined"], "properties": { "classification": { "enum": ["relative_clause", "appositive_that", "subject_verb_agreement", "participle_clause", "nonrestrictive_relative", "pronoun_agreement", "dummy_it", "cleft_it_that"] }, "decisionRule": { "type": "string", "minLength": 1 }, "contrastWith": { "type": "string" }, "isUniquelyDetermined": { "const": true } } },
        "sourceTextModified": { "const": false }
      }
    },
    "qualityReview": {
      "type": "object", "additionalProperties": false, "required": ["passage", "questions"],
      "properties": {
        "passage": { "type": "object", "additionalProperties": false, "required": ["naturalness", "logicStructure", "vocabularyLevel", "templateFidelity"], "properties": { "naturalness": { "type": "number", "minimum": 0, "maximum": 10 }, "logicStructure": { "type": "number", "minimum": 0, "maximum": 10 }, "vocabularyLevel": { "type": "number", "minimum": 0, "maximum": 10 }, "templateFidelity": { "type": "number", "minimum": 0, "maximum": 10 } } },
        "questions": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["slot", "answerInference", "distractorPlausibility", "choiceBalance", "directAnswerOverlap", "strongestDistractorIndex", "decisiveReason", "expectedDifficulty"], "properties": { "slot": { "type": "string" }, "answerInference": { "type": "number" }, "distractorPlausibility": { "type": "number" }, "choiceBalance": { "type": "number" }, "directAnswerOverlap": { "type": "boolean" }, "strongestDistractorIndex": { "type": "integer", "minimum": 1, "maximum": 5 }, "decisiveReason": { "type": "string" }, "expectedDifficulty": { "type": "number", "minimum": 1, "maximum": 5 } } } }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "templateId", "variantId", "questionType", "choiceLanguage", "vocabularyLevel", "contentMatchPolarity", "grammarTarget", "grammarMode", "question", "materialOperation"],
      "properties": {
        "itemId": { "type": "string" }, "templateId": { "enum": ["school-content-match", "school-content-inference", "school-sentence-insertion", "school-grammar", "school-summary"] }, "variantId": { "const": "standard" },
        "questionType": { "enum": ["content_match", "content_inference", "sentence_insertion", "grammar", "summary"] }, "choiceLanguage": { "enum": ["ko", "en", null] },
        "vocabularyLevel": { "enum": ["source_matched", "grade_1", "grade_2", "grade_3_csat"] }, "contentMatchPolarity": { "enum": ["match", "mismatch", null] },
        "grammarTarget": { "enum": ["relative_clause", "appositive_that", "subject_verb_agreement", "participle_clause", "nonrestrictive_relative", "pronoun_agreement", "dummy_it", "cleft_it_that", null] },
        "grammarMode": { "enum": ["source_form_check", "controlled_error_variant", null] }, "question": { "$ref": "#/$defs/question" },
        "materialOperation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/insertionOperation" }, { "$ref": "#/$defs/grammarOperation" }] }, "qualityReview": { "$ref": "#/$defs/qualityReview" }
      }
    }
  }
}
