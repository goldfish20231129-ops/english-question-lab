    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
